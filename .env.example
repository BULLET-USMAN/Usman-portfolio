# Copy this file to .env.local and fill in real values before deploying.
# Nothing here is currently required to run the site locally — every
# value has a safe placeholder fallback in code.

# The production domain, once you have one. Used for canonical URLs,
# sitemap.xml, robots.txt, and Open Graph/Twitter metadata. Without
# this set, the site falls back to a clearly-placeholder domain.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
